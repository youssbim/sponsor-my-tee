# Copy to .env.local. Leave everything empty to run in demo mode
# (local JSON store + fake checkout, admin password "admin").

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Supabase — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin at /adm
ADMIN_PASSWORD=

# Optional: emails to bidders (Resend) and to you
RESEND_API_KEY=
RESEND_FROM=
ADMIN_EMAIL=
